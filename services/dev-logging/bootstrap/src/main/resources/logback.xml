<configuration>
  <!-- Bootstrap/pool diagnostics must never dump private file values, JDBC credentials or raw driver causes. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%date{ISO8601} %level %logger{36} - %msg%n</pattern></encoder>
  </appender>
  <logger name="com.zaxxer.hikari" level="OFF"/>
  <logger name="org.postgresql" level="OFF"/>
  <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
