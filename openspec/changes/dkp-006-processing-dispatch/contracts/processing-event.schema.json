{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documentknowledge.example/contracts/processing-event/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateRevision",
    "occurredAt",
    "actorRef",
    "tenantScope",
    "correlationId",
    "causationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "DocumentVersionAccepted",
        "DocumentProcessingEnrolled",
        "DocumentProcessingCancellationRequested",
        "DocumentProcessingStateChanged"
      ]
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "ProcessingRun UUID, never documentId."
    },
    "aggregateRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Contiguous per-run processing-event sequence, allocated only with an event; distinct from runRevision and documentRevision."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "subject"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "tenantScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "causationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "versionId",
        "processingRunId",
        "intentId",
        "profileDigest",
        "state",
        "runRevision",
        "documentRevision"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "versionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "processingRunId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "intentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "profileDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "ACCEPTED_PENDING_DISPATCH",
            "DISPATCHED",
            "RUNNING",
            "WAITING_FOR_CAPABILITY",
            "BLOCKED_AUTHORITY",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED",
            "TIMED_OUT_RECONCILING",
            "TIMED_OUT"
          ]
        },
        "runRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "documentRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "DocumentVersionAccepted",
              "DocumentProcessingEnrolled"
            ]
          }
        },
        "required": [
          "eventType"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "state": {
                "const": "ACCEPTED_PENDING_DISPATCH"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "DocumentProcessingCancellationRequested"
          }
        },
        "required": [
          "eventType"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "state": {
                "const": "CANCEL_REQUESTED"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
