  "schemas": {
    "ShareDocumentExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expectedDocumentRevision": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ShareBatchAssessmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/components/schemas/ShareDocumentExpectation"
          },
          "description": "Semantic uniqueness by documentId regardless expected revision; duplicate IDs fail422 DUPLICATE_DOCUMENT before lookup. Server sorts canonical UUIDs."
        }
      }
    },
    "ShareAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "documentRevision",
        "classification",
        "classificationPolicyRevision"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "documentRevision": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "classification": {
          "const": "development-restricted"
        },
        "classificationPolicyRevision": {
          "const": 1
        }
      }
    },
    "ShareBatchAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "tenant",
        "action",
        "assessments"
      ],
      "properties": {
        "actor": {
          "$ref": "#/components/schemas/Actor"
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "const": "document.share-to-collection"
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/components/schemas/ShareAssessment"
          },
          "description": "Exact complete requested document set in canonical UUID order; no duplicates/omissions/extras/partial result."
        }
      }
    },
    "ShareEligibilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentIds"
      ],
      "properties": {
        "documentIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      },
      "description": "Complete locally scoped candidate set; canonical distinct UUIDs, sorted by UUID before digest. Duplicate UUID422 DUPLICATE_DOCUMENT before resource lookup. No actor, tenant, action, classification or expected revision override."
    },
    "ShareEligibilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "tenant",
        "action",
        "requestedSetDigest",
        "eligible"
      ],
      "properties": {
        "actor": {
          "$ref": "#/components/schemas/Actor"
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "const": "document.share-to-collection"
        },
        "requestedSetDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "eligible": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/components/schemas/ShareAssessment"
          }
        }
      },
      "description": "Distinct typed discovery result, NEVER strict assessment. Actor/tenant/action bind request. requestedSetDigest=lowercase SHA256 of UTF8 compact JSON sorted unique UUID string array. eligible is sorted unique authorized metadata subset ONLY; denied, missing and foreign documents omitted indistinguishably. No denied IDs/counts/reasons/status/index/authority fingerprint. Whole uncertainty503; empty authorized subset is200."
    }
