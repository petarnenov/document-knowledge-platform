  "components": {
    "securitySchemes": {
      "WorkloadMTLS": {
        "type": "mutualTLS",
        "description": "PrivateCA exact configured URI SAN+EKU+validity and role allowlist; no development bypass."
      }
    },
    "schemas": {
      "ResolveOriginalRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedRunRevision",
          "attemptEpoch"
        ],
        "properties": {
          "expectedRunRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "attemptEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "OriginalResolution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "documentId",
          "versionId",
          "processingRunId",
          "sourceSha256",
          "sizeBytes",
          "mimeType",
          "profileDigest",
          "schemaFingerprint",
          "originalTrust",
          "retentionResolution",
          "observedAt",
          "resolutionId",
          "inputDigest"
        ],
        "properties": {
          "schemaVersion": {
            "const": "1.0.0"
          },
          "documentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "versionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "processingRunId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "application/vnd.openxmlformats-officedocument.presentationml.presentation",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            ]
          },
          "profileDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "schemaFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "originalTrust": {
            "const": "VERIFIED_IMMUTABLE_ORIGINAL"
          },
          "retentionResolution": {
            "const": "UNRESOLVED"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolutionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "inputDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "description": "Immutable server-issued resolution. observedAt is the first committed observation, not the current authorization time. Replays revalidate current authority independently; this object confers no grant."
      },
      "CheckpointReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "processingRunId",
          "runRevision",
          "checkpointId"
        ],
        "properties": {
          "processingRunId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "runRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "checkpointId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "TENANT_DENIED",
              "AUTHORITY_UNAVAILABLE",
              "STALE_REVISION",
              "IDEMPOTENCY_CONFLICT",
              "INVALID_ARTIFACT",
              "LIMIT_EXCEEDED",
              "TOO_MANY_REQUESTS",
              "UNAVAILABLE",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "NOT_ACCEPTABLE"
            ]
          }
        }
      },
      "AttemptHandoffRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflowId",
          "workflowExecutionId",
          "workflowInputDigest",
          "stage"
        ],
        "properties": {
          "workflowId": {
            "type": "string",
            "pattern": "^dkp-processing-v1/[0-9a-f-]{36}$",
            "maxLength": 64
          },
          "workflowExecutionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "workflowInputDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stage": {
            "const": "RESOLVE_ORIGINAL_V1"
          }
        }
      },
      "AttemptHandoff": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "processingRunId",
          "attemptEpoch",
          "expectedRunRevision",
          "inputDigest",
          "checkpoint"
        ],
        "properties": {
