    "/internal/v1/processing-runs/{processingRunId}/checkpoints": {
      "post": {
        "tags": [
          "ProcessingWorkload"
        ],
        "operationId": "recordProcessingCheckpoint",
        "summary": "recordProcessingCheckpoint",
        "description": "Reference only a server-issued immutable resolution. First write requires current attempt/revision; exact already-committed semantic checkpoint replays original200 after fresh actor/workload/current-stage/compatible-input checks, even if original revision advanced or current epoch differs. Different resolution/input binding409; stale uncommitted write409; cancellation/deadline denies. Whole2s. See protocol-recovery.md.",
