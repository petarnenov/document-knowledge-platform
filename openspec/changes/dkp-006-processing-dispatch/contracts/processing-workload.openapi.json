    "/internal/v1/processing-runs/{processingRunId}/attempt-handoffs": {
      "post": {
        "tags": [
          "ProcessingWorkload"
        ],
        "operationId": "acquireProcessingAttempt",
        "summary": "acquireProcessingAttempt",
        "description": "Server-issued current attempt handoff. Fresh workload+accepted actor authority and authoritative exact Temporal execution/start-input fingerprint required. Durable attempt exists BEFORE Start. Early worker and lost Start ACK reconcile the same execution; no caller-chosen epoch. Whole2s, unknown503, no remote call under SQL. See protocol-recovery.md.",
        "security": [
          {
            "WorkloadMTLS": []
          }
        ],
        "parameters": [
          {
            "name": "processingRunId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "description": "Opaque exact current owned run."
