{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documentknowledge.example/contracts/original-resolution/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "versionId",
    "processingRunId",
    "sourceSha256",
    "sizeBytes",
    "mimeType",
    "profileDigest",
    "schemaFingerprint",
    "originalTrust",
    "retentionResolution",
    "observedAt",
    "resolutionId",
    "inputDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "documentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "versionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "processingRunId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "mimeType": {
      "type": "string",
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ]
    },
    "profileDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schemaFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "originalTrust": {
      "const": "VERIFIED_IMMUTABLE_ORIGINAL"
    },
    "retentionResolution": {
      "const": "UNRESOLVED"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "resolutionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Immutable server-issued resolution. observedAt is the first committed observation, not the current authorization time. Replays revalidate current authority independently; this object confers no grant."
}
