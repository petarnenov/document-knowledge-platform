  "semanticCases": [
    {
      "name": "same-sha-distinct-compilations",
      "expect": "Distinct buildIds retained; separate execution runIds; real two-build common-store query"
    },
    {
      "name": "duplicate-json-properties",
      "expect": "400 before DB dispatch; parser rejects duplicate names"
    },
    {
      "name": "multibyte-and-beacon-overhead",
      "expect": "Whole envelope at most32768 UTF-8 bytes, event8192, maximum32events; actual encoded bytes tested"
    },
    {
      "name": "idempotent-unknown-commit",
      "expect": "Same canonical event and scope returns COMMITTED without duplicate; actual PostgreSQL unknown-response test"
    },
    {
      "name": "same-id-isolated-scopes",
      "expect": "Same parent and UUID in different authorized scopes are independent; no cross-scope409/existence oracle; original accepted spool envelope cannot be relabeled"
    },
    {
      "name": "six-hundred-epoch-rotations",
      "expect": "One reusable parent,600 bounded scoped delegations; original scopes immutable"
    },
    {
      "name": "stale-tab-shared-cookie",
      "expect": "Old event epoch403 after tenant/session transition, no actor relabel"
    },
    {
      "name": "parallel-tabs",
      "expect": "Distinct browser run bindings coexist under same identity epoch; one tab does not retire another merely by registering"
    },
    {
      "name": "authenticated-no-tenant",
      "expect": "AUTHENTICATED_UNSELECTED operator-only; no tenant fabricated"
    },
    {
      "name": "receipt-scope-probe",
      "expect": "Outside scope and absent event both UNKNOWN; expired/revoked grant denied"
    },
    {
      "name": "manifest-digest-and-vocabulary",
      "expect": "Unknown/mismatched manifest or phase/class/version/code rejected; no dynamic catalog admission from errors"
    },
    {
      "name": "producer-token-response",
      "expect": "Secret returned only to authorized operator/attestor, no-store, never writeOnly omission or browser/telemetry output"
    },
    {
      "name": "expired-spool",
      "expect": "Terminal EXPIRED after original horizon; cannot re-register old producer or relabel scope"
    },
    {
      "name": "delayed-beacon",
      "expect": "Real user action completes independently of delayed ingestion response; true is not persistence"
    },
    {
      "name": "raw-secret-or-document",
      "expect": "Excluded at producer AND ingress, typed debug class/phase/source frames remain useful"
    },
    {
      "name": "shared-store-restart",
      "expect": "Two real builds FE/BE/infra retained after service restart and task-fixture cleanup"
    },
    {
      "name": "same-scope-changed-content",
      "expect": "409 only within same parent/scope/event identity; no prior contents disclosed"
    },
    {
      "name": "expired-payload-tombstone-ingest",
      "expect": "Whole batch410 LOG_EVENT_EXPIRED, never COMMITTED or recreated; own-scope lookupEXPIRED with no timestamp; bounded split/retry of other events"
    }
  ],
