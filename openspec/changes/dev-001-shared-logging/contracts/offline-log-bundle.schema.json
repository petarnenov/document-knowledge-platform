{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-knowledge-platform.dev/proposed/dev-logging/offline-bundle-v1.schema.json",
  "title": "Proposed sanitized offline telemetry bundle v1; untrusted until authorized import",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buildId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$",
          "maxLength": 96
        },
        "gitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 40
        },
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        }
      },
      "required": [
        "buildId",
        "runId",
        "instanceId",
        "component",
        "gitSha",
        "sourceFingerprint"
      ]
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "LOCAL"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "GITHUB_ACTIONS"
            },
            "repository": {
              "const": "petarnenov/document-knowledge-platform"
            },
            "workflow": {
              "enum": [
                ".github/workflows/foundation.yml",
                ".github/workflows/bp03-aggregate.yml",
                ".github/workflows/repository-hygiene.yml"
              ]
            },
            "runId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$",
              "maxLength": 20
            },
            "runAttempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "job": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "maxLength": 96
            },
            "matrix": {
              "enum": [
                "NONE",
                "document-management",
                "knowledge-base",
                "knowledge-search",
                "browser-bff"
              ]
            },
            "check": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "maxLength": 96
            }
          },
          "required": [
            "kind",
            "repository",
            "workflow",
            "runId",
            "runAttempt",
            "job",
            "matrix",
            "check"
          ]
        }
      ]
    },
    "manifestBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1398104,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventBase64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 10924,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          }
        },
        "required": [
          "eventBase64",
          "sha256"
        ]
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "persisted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "writeFailures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished": {
          "type": "boolean"
        }
      },
      "required": [
        "admitted",
        "persisted",
        "rejected",
        "dropped",
        "writeFailures",
        "finished"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "execution",
    "origin",
    "manifestBase64",
    "manifestSha256",
    "artifactSha256",
    "events",
    "collection"
  ]
}
